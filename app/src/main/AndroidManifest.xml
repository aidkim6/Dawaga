<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 인터넷 및 위치 권한 설정 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dawaga">

        <!-- 카카오맵 SDK 네이티브 앱 키 -->
        <meta-data
            android:name="com.kakao.vectormap.APP_KEY"
            android:value="${KAKAO_NATIVE_APP_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".FirstRunActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ArrivalStatusActivity"
            android:exported="true" />
        <activity
            android:name=".CreatePromiseActivity"
            android:exported="false" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PromiseSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PromiseWaitingActivity"
            android:exported="false" />
        <activity
            android:name=".JoinPromiseActivity"
            android:exported="false" />

        <!-- 위치 공유 화면 (location 패키지) -->
        <activity
            android:name=".location.LocationShareWaitingActivity"
            android:exported="false" />
        <activity
            android:name=".location.LocationPermissionActivity"
            android:exported="false" />
        <activity
            android:name=".location.LocationErrorActivity"
            android:exported="false" />
    </application>


</manifest>
