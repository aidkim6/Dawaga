<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- 상단 타이틀 -->
        <TextView
            android:id="@+id/tv_home_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="홈"
            android:textColor="#0F172A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_home_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="약속을 만들거나 초대 코드로 참여해 보세요."
            android:textColor="#64748B"
            android:textSize="14sp" />

        <!-- 내 닉네임 & 메인 문구 카드 -->
        <LinearLayout
            android:id="@+id/card_hero_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_home_card"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/home_profile_photo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:clipToOutline="true"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile_avatar" />

                <TextView
                    android:id="@+id/tv_soyeon_user_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="내 닉네임"
                    android:textColor="#475569"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_hero_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="6dp"
                android:text="오늘도 약속 장소까지\n누가 먼저 도착할까요?"
                android:textColor="#0F172A"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 액션 카드 1: 새로운 약속 만들기 -->
        <LinearLayout
            android:id="@+id/card_create_promise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_home_card"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="새로운 약속 만들기"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="장소와 시간을 정하고 친구를 초대해요"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 액션 카드 2: 초대 코드로 참여 -->
        <LinearLayout
            android:id="@+id/card_join_by_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_card"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="초대 코드로 참여"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="친구에게 받은 6자리 코드를 입력해요"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 섹션 타이틀: 참여 중인 약속 -->
        <TextView
            android:id="@+id/tv_active_promises_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="참여 중인 약속"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 약속이 하나도 없을 때 표시되는 빈 상태 카드 -->
        <LinearLayout
            android:id="@+id/card_empty_promise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아직 참여 중인 약속이 없어요"
                android:textColor="#475569"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="위에서 새 약속을 만들거나 초대 코드로 참여해 보세요"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 약속 생성/참여 후 동적으로 카드가 추가되는 영역 -->
        <LinearLayout
            android:id="@+id/layout_active_promise_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- 하단 지난 약속 보기 링크 -->
        <TextView
            android:id="@+id/tv_past_promises"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="지난 약속 보기  →"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <!-- 기존 팀원 테스트 ID 보존 영역 -->
        <LinearLayout
            android:id="@+id/layout_dev_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.kakao.vectormap.MapView
                android:id="@+id/map_view"
                android:layout_width="match_parent"
                android:layout_height="200dp" />

            <TextView
                android:id="@+id/tv_soyeon_auth_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="익명 로그인 상태: 확인 중..." />

            <EditText
                android:id="@+id/et_soyeon_nickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:hint="닉네임 입력"
                android:inputType="text"
                android:minHeight="48dp" />

            <Button
                android:id="@+id/btn_soyeon_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 닉네임 등록" />

            <Button
                android:id="@+id/btn_soyeon_rename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. 닉네임 수정" />

            <EditText
                android:id="@+id/et_soyeon_room_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="postalCode"
                android:hint="방 코드 6자리"
                android:inputType="text"
                android:minHeight="48dp" />

            <Button
                android:id="@+id/btn_soyeon_create_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. 방 생성 (createRoom)" />

            <Button
                android:id="@+id/btn_soyeon_join_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. 방 코드 검증" />

            <TextView
                android:id="@+id/tv_soyeon_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="타이머 대기 중" />

            <Button
                android:id="@+id/btn_soyeon_fast_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. [시연용] 5초 카운트다운, 화면 전환" />

            <Button
                android:id="@+id/btn_create_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="방 생성" />

            <Button
                android:id="@+id/btn_simulate_move"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="시뮬레이터 이동" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
