<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".JoinPromiseActivity">

    <!-- 하단 고정 버튼: 참여 확인 / 다시 입력하기 -->
    <Button
        android:id="@+id/btn_confirm_promise"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_primary_button"
        android:stateListAnimator="@null"
        android:text="참여 확인"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btn_confirm_promise"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- 상단 헤더: < 초대 코드 입력 / 코드 오류 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_back_join"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="-12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="뒤로 가기"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_join_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="초대 코드 입력"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_join_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="친구에게 받은 6자리 코드를 입력해 주세요."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- 초대 코드 라벨 (박스 바깥 상단) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="72dp"
                android:text="초대 코드"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 6자리 코드 입력 박스 -->
            <EditText
                android:id="@+id/et_invite_code"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:hint="A1B2C3"
                android:inputType="textCapCharacters"
                android:letterSpacing="0.3"
                android:maxLength="6"
                android:maxLines="1"
                android:paddingHorizontal="18dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#CBD5E1"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- 오류 시 나타나는 경고 문구 -->
            <TextView
                android:id="@+id/tv_error_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="⚠️ 유효하지 않은 초대 코드예요."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 하단 안내 문구 -->
            <TextView
                android:id="@+id/tv_join_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="코드가 맞으면 약속 정보를 확인할 수 있어요."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>